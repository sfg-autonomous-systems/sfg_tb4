<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>sfg_fastdds_utils</name>
    <version>0.0.0</version>
    <description>Utility library to directly bridge ROS 2 types to raw FastDDS participants.</description>
    <maintainer email="constantin.blessing@hs-esslingen.de">Constantin Blessing</maintainer>
    <license>MIT</license>

    <depend>fastdds</depend>
    <depend>rclcpp</depend>
    <depend>rmw</depend>
    <depend>rmw_fastrtps_cpp</depend>
    <depend>rcpputils</depend>
    <depend>sfg_utils</depend>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>